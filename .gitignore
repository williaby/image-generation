# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
*.env

# Generated images (except examples)
output/drafts/*
output/finals/*
output/*.png
output/*.jpg
output/*.jpeg
output/*.webp
output/*.gif
output/*.signature.bin
!output/.gitkeep

# Loose image files in project root (generated by script test runs)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Test/coverage artifacts
.coverage
htmlcov/
coverage.xml

# Keep example prompts
!examples/PROMPTS.md

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Qlty code quality tool (track config only)
.qlty/*
!.qlty/qlty.toml

# AI assistant state (track CLAUDE.md and settings.json; catch-all with
# negation is safer than enumeration; mirrors ~/dev/.github/.gitignore template)
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json

# Worktrees and compliance report artifacts
.worktrees/
docs/compliance-reports/
